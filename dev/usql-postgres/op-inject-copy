#!/usr/bin/env bash
set -euo pipefail

in_file=""
out_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    inject)
      shift
      ;;
    --in-file)
      in_file="$2"
      shift 2
      ;;
    --out-file)
      out_file="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -z "$in_file" || -z "$out_file" ]]; then
  echo "usage: op-inject-copy inject --in-file <path> --out-file <path>" >&2
  exit 2
fi

cp "$in_file" "$out_file"
