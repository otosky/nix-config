{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track upstream releases used by local Nix packages.",
      "managerFilePatterns": ["/(^|/)pkgs/[^/]+/default\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+version = \\\"(?<currentValue>[^\\\"]+)\\\";"
      ]
    },
    {
      "customType": "regex",
      "description": "Track hinted Nix flake input refs.",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) packageName=(?<packageName>\\S+) versioning=(?<versioning>\\S+)\\s+(?<depName>[A-Za-z0-9_-]+)\\.url = \\\"github:[^\\\"]+/(?<currentValue>[^\\\"]+)\\\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group Nix flake lockfile updates.",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Let the regex hint manage stable NixOS channel upgrades.",
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs-stable"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Run the Nix refresh workflow after custom regex updates.",
      "matchManagers": ["custom.regex"],
      "labels": ["dependencies", "nix-hash-refresh"]
    }
  ]
}
